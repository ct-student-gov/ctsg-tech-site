{
  "name": "ctsg-notion-sync",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "SYNC_QUEUE", "class_name": "NotionSyncQueue" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NotionSyncQueue"] }]
  // Secrets: GITHUB_DISPATCH_TOKEN, NOTION_CALENDAR_WEBHOOK_SECRET,
  // NOTION_PEOPLE_WEBHOOK_SECRET, NOTION_BLOG_WEBHOOK_SECRET.
  // The queue stores routing hints only.
}
